# このファイルを .env にコピーして使う（cp .env.example .env）。.env は git に入らない。
# docker compose が同じディレクトリの .env を自動で読む。
#
# 何も設定しなくても `docker compose up --build` は動く（下の既定値で起動する）。
# ただし**それは開発用の既定値**であって、公開する場所で使ってよい値ではない。
# ここに並んでいるのは「公開前に必ず自分の値へ替えるもの」の一覧でもある。
#
# 生成例:
#   APP_JWT_SECRET      -> openssl rand -base64 48
#   APP_ADMIN_PASSWORD  -> openssl rand -base64 24
#   EC_DB_PASSWORD      -> openssl rand -base64 24

# ============================================================
# 公開前に必ず替える3つ（危険度の高い順）
# ============================================================

# 🔴 JWT の署名鍵。**パスワードより深刻**。
#    これが既定のままだと、誰でも「自分は管理者だ」と書いたトークンを偽造できる。
#    パスワードを強くしても意味が無くなるので、まずここを替える。32バイト以上。
APP_JWT_SECRET=local-dev-secret-please-change-me-32bytes-minimum

# 🟠 初期管理者。空のDBに対して起動時に1度だけ作られる。
#    README に既定値が載っている＝公開値なので、そのままだと管理画面に入られる。
APP_ADMIN_EMAIL=admin@example.com
APP_ADMIN_PASSWORD=admin1234

# 🟠 PostgreSQL のパスワード。compose の db と api の両方に効く。
EC_DB_PASSWORD=ecapi

# ⚠️ デモユーザー `user@example.com` / `user1234` は**現状ここで変更できない**
#    （DataSeeder に直書き）。USER ロールなので管理APIには届かないが、
#    実運用に使うなら APP_SEED_ENABLED=false でシードごと切ること。

# ============================================================
# 動作設定（既定のままで動く）
# ============================================================

# シードデータ（カテゴリ・商品・管理者・デモユーザー）を起動時に入れるか。
# **実運用なら false**。true のままだと上のデモ用アカウントが作られる。
APP_SEED_ENABLED=true

# ホスト側の公開ポート。コンテナ内は常に 8080 固定。
HOST_PORT=8080

# 送料の初期値（0=送料なし / 0=送料無料にならない）。以後は管理画面の設定が優先。
APP_SHIPPING_FEE=0
APP_SHIPPING_FREE_THRESHOLD=0

# 商品画像・ロゴの保存先。**jar の外＝永続ボリューム**にすること
# （コンテナを作り直すと消えるため）。
APP_UPLOADS_DIR=/app/uploads

# ヘッダの看板（店名とロゴ）の**初期値**。以後は管理画面の設定が優先される。
# APP_STORE_LOGO_URL を空にすると、ロゴの代わりに店名の文字が出る。
APP_STORE_NAME=和雑貨 みやび
APP_STORE_LOGO_URL=images/brand/miyabi-logo-premium.svg

# ============================================================
# 公開デモとして見せるとき（既定はすべて無効）
# ============================================================
# 管理画面を「隠す」のではなく「壊せない・盗る物が無い」状態にするための設定。
# 配布物として持ち出した環境で勝手に制限がかかると機能欠陥に見えるので、既定は無効。

# /api/admin/** への書き込み（POST/PUT/PATCH/DELETE）を 403 にする。
# 画像アップロード（サーバーへのファイル書き込み）もここで止まる。
APP_DEMO_READ_ONLY=false

# 管理画面の応答で連絡先メールを伏せ字にする（本人の照会では伏せない）。
APP_DEMO_MASK_CONTACT=false

# 何日経った注文の連絡先を消すか。0=消さない。
# ⚠ 注文自体は消さない（消すと売上集計から過去が消える）。
APP_DEMO_RETENTION_DAYS=0

# ⚠️ READ_ONLY=true のときは**二段階認証の登録・解除も拒否**される。
#    管理者アカウントを共有する公開デモで誰か一人が自分の認証アプリを登録すると、
#    他の全員が入れなくなるため（ログイン自体は塞がない）。

# 二段階認証（TOTP）。各ユーザーが管理画面から有効にする（既定は無効）。
# 認証アプリに表示される発行者名と、二段階目の引換券の寿命。
APP_MFA_ISSUER=EC API
APP_JWT_MFA_EXPIRATION_MS=300000

# ============================================================
# 決済（任意）
# ============================================================
# テスト用キーのみ。空なら決済は無効のまま起動する（注文までは動く）。
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# 銀行振込（外部APIもWebhookも持たない決済手段の例）。
BANK_TRANSFER_ENABLED=false

# ============================================================
# 通知メール（任意・既定は無効）
# ============================================================
# 有効にするなら spring.mail.* の SMTP 設定も別途必要。
NOTIFY_MAIL_ENABLED=false
NOTIFY_MAIL_FROM=no-reply@example.com
# 空でなければ受注通知を管理者にも送る。
NOTIFY_MAIL_ADMIN=
# 通知メールに載せる絶対リンクの基点（context-path 込み）。
# 未設定なら直リンクの代わりに注文番号＋トークンを本文に書く。
PUBLIC_BASE_URL=
